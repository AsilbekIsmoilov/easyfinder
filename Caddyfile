# Sertifikat Let's Encrypt'dan avtomatik olinadi va o'zi yangilanadi.
# Domen .env.caddy dagi APP_DOMAIN dan keladi.
{$APP_DOMAIN} {
	encode zstd gzip

	# Telegram Mini App iframe ichida ochiladi — X-Frame-Options qo'ymaymiz.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Rasmlarni Python emas, Caddy uzatadi: fayl to'g'ridan-to'g'ri yadro
	# orqali ketadi va api konteyneriga yuk tushmaydi. Cache-Control tufayli
	# brauzer rasmni bir hafta saqlaydi — takroriy ochilishda so'rov bo'lmaydi.
	handle_path /media/* {
		root * /srv/media
		file_server
		header Cache-Control "public, max-age=604800"
	}

	handle {
		reverse_proxy api:8000
	}
}
