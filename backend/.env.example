# Bu SHABLON fayl — bu yerga haqiqiy kalit yozmang.
# Nusxa oling: copy .env.example .env  — va kalitlarni .env ichiga qo'ying.

# --- Telegram (my.telegram.org -> API development tools) ---
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Birinchi marta `python -m app.scraper.telegram --login` ishga tushiring,
# u sizga session string beradi. Shu yerga qo'ying.
TELEGRAM_SESSION=

# Scrap qilinadigan kanallar (vergul bilan, @ belgisiz)
TELEGRAM_CHANNELS=mandarintour,kishmishtraveluz

# Har bir kanaldan bir martada nechta post o'qilsin
SCRAPE_LIMIT=50


# --- Bot (mini app tugmasi uchun) ---
TELEGRAM_BOT_TOKEN=

# --- Claude extraction (console.anthropic.com dan API kalit) ---
# Turlarni ajratishning yagona yo'li — bu kalit majburiy.
CLAUDE_API=
CLAUDE_MODEL=claude-opus-5

# MySQL production: mysql+pymysql://tour_user:strong_password@127.0.0.1:3306/tour_finder?charset=utf8mb4
DATABASE_URL=sqlite:///./tours.db
REDIS_URL=redis://127.0.0.1:6380/0
CACHE_TTL_SECONDS=60
# R2/S3/CDN yoqilganda media public base URL
MEDIA_BASE_URL=

SCRAPE_PREFILTER=true
SCRAPE_HISTORY_DAYS=365
# Yangi postlarni yig'ish va tahlil qilish vaqti
CREATE_SCHEDULE=20:00
# Tahrirlangan postlarni tekshirish vaqti
UPDATE_SCHEDULE=21:00
PIPELINE_TIMEZONE=Asia/Tashkent
# Limit ogohlantirishi va update hisoboti shu chat'ga yuboriladi (bo'sh = yuborilmaydi)
ADMIN_CHAT_ID=
TELEGRAM_WEBAPP_URL=
ADMIN_JOB_KEY=CHANGE_ME_ADMIN_KEY
PIPELINE_NOTIFICATIONS_ENABLED=false
