# Internal Docker service URLs. MYSQL_PASSWORD bilan bir xil password yozing.
DATABASE_URL=mysql+pymysql://tour_user:CHANGE_ME@mysql:3306/tour_finder_free?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=60
RUN_STARTUP_MIGRATIONS=false

TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=CHANGE_ME
TELEGRAM_SESSION=CHANGE_ME
TELEGRAM_CHANNELS=freshtouruz,mandarintour,CentralTur_uz,Asialuxe,inapptravelchannel,ditraveluz,Clubtravel_uz,travelsystemuz,anortravelchannel,viatravel_uz,yurtur_uz,manoruz,satori_tour_uz,viptraveluz
TELEGRAM_BOT_TOKEN=CHANGE_ME
SCRAPE_LIMIT=200


# R2/S3 ishlatilmasa bo'sh qoldiring.
MEDIA_BASE_URL=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Faqat compose --profile tunnel ishlatilsa kerak.
TUNNEL_TOKEN=
SCRAPE_PREFILTER=true
SCRAPE_HISTORY_DAYS=365
PIPELINE_SCHEDULE=08:00,13:00,21:00
PIPELINE_TIMEZONE=Asia/Tashkent
TELEGRAM_WEBAPP_URL=
ADMIN_JOB_KEY=CHANGE_ME_ADMIN_KEY