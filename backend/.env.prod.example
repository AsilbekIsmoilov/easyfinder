# ============================================================
#  EasyFinder(Beta) — PRODUCTION SHABLONI
#  Nusxa oling:  cp backend/.env.prod.example backend/.env.production
#  CHANGE_ME qolgan joylar to'ldirilmasa tizim ishlamaydi.
# ============================================================

# --- Telegram API (my.telegram.org -> API development tools) ---
TELEGRAM_API_ID=36110784
TELEGRAM_API_HASH=fe4c840637902b3ca82e2030cd4d0781

# Yig'uvchi akkaunt sessiyasi (@playstrongdota — shaxsiy akkaunt EMAS).
# Bu sessiya faqat SHU serverda ishlatilsin. Uyda ham kerak bo'lsa,
# `python -m app.scraper.telegram --login` bilan alohida sessiya oling.
TELEGRAM_SESSION=

# Kuzatiladigan kanallar (vergul bilan, @ belgisiz)
TELEGRAM_CHANNELS=mandarintour,kishmishtraveluz

# Har bir kanaldan bir yurishda nechta xabar o'qilsin
SCRAPE_LIMIT=50
SCRAPE_PREFILTER=true
SCRAPE_HISTORY_DAYS=365

# --- Bot ---
# ⚠️ CHANGE_ME: eski token suhbatda ko'ringan, @BotFather orqali yangilang
TELEGRAM_BOT_TOKEN=

# --- Claude (turlarni ajratishning yagona yo'li) ---
# ⚠️ CHANGE_ME: eski kalit suhbatda ko'ringan, console.anthropic.com da yangilang
CLAUDE_API=
CLAUDE_MODEL=claude-opus-5

# --- Ma'lumotlar bazasi ---
# Parol .env.mysql dagi MYSQL_PASSWORD bilan bir xil bo'lishi SHART
DATABASE_URL=mysql+pymysql://tour_user:SIZNING_PAROL@mysql:3306/tour_finder?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=60
RUN_STARTUP_MIGRATIONS=false

# --- Jadval (Toshkent vaqti) ---
# 20:00 — yangi postlarni yig'ish va tahlil qilish
# 21:00 — tahrirlangan postlarni tekshirish va turlarni yangilash
CREATE_SCHEDULE=20:00
UPDATE_SCHEDULE=21:00
PIPELINE_TIMEZONE=Asia/Tashkent

# --- Xabarlar ---
# Obunachilarga pipeline statistikasi yuborilsinmi
PIPELINE_NOTIFICATIONS_ENABLED=true
# Limit ogohlantirishi va update hisoboti shu chat'ga ketadi (@imbackendeveloper)
ADMIN_CHAT_ID=

# --- Mini App ---
# ⚠️ CHANGE_ME: haqiqiy HTTPS domen. Keyin `python -m app.bot_setup <URL>` ishga tushiring
TELEGRAM_WEBAPP_URL=

# --- Admin API ---
ADMIN_JOB_KEY=uzun-tasodifiy-kalit-generatsiya-qiling

# --- Media ---
MEDIA_BASE_URL=

# --- Cloudflare Tunnel (ixtiyoriy, --profile tunnel bilan) ---
# TUNNEL_TOKEN=
